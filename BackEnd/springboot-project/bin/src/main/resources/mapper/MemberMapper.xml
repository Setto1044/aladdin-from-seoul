<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aladin.member.mapper.MemberMapper">

	<!-- Member 객체를 MemberVo로 매핑하는 ResultMap -->
	<resultMap id="memberMap" type="com.aladin.member.vo.MemberVo">
		<result column="id" property="id" />
		<result column="username" property="username" />
		<result column="password" property="password" />
		<result column="name" property="name" />
		<result column="nickname" property="nickname" />
		<result column="email" property="email" />
		<result column="grade" property="grade" />
		<result column="status" property="status" />
		<result column="created_at" property="createdAt" />
		<result column="last_joined_at" property="lastjoinedAt" />
		<result column="deleted_at" property="deletedAt" />
		<result column="profile_image_path" property="profileImagePath" />
		<result column="bio" property="bio" />
	</resultMap>

	<!-- 중복된 username 또는 email이 있는지 확인하는 쿼리 -->
	<select id="isDuplicatedUsername" resultType="boolean">
		SELECT COUNT(1) > 0
		FROM members
		WHERE username = #{username}
	</select>

	<select id="isDuplicatedEmail" resultType="boolean">
		SELECT COUNT(1) > 0
		FROM members
		WHERE email = #{email}
	</select>

	<insert id="registerMember" parameterType="com.aladin.member.dto.MemberRegistRequestDto">
		INSERT INTO members
		(username, password, name, nickname,
		email, grade)
		VALUES (
		#{username},
		#{password},
		#{name},
		#{nickname},
		#{email},
		#{grade}
		)
	</insert>

	<!-- 로그인 시 사용자 정보를 조회하는 쿼리 -->
	<select id="findMemberByUsernameAndPassword" resultType="com.aladin.member.dto.LogInResponseDto">
		SELECT username, name, nickname, email, profile_image_path AS
		profileImagePath, grade, bio
		FROM members
		WHERE username = #{username} AND password = #{password}
		AND status = 'ACTIVE' -- 활동 중인 회원만 조회
	</select>

</mapper>
